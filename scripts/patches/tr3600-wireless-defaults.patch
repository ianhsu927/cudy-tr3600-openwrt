--- a/package/network/config/wifi-scripts/files/lib/wifi/mac80211.uc
+++ b/package/network/config/wifi-scripts/files/lib/wifi/mac80211.uc
@@ -8,6 +8,9 @@
 let board = json(readfile("/etc/board.json"));
 if (!board.wlan)
 	exit(0);
+
+// These are public first-boot defaults, never replacements for saved radios.
+const tr3600 = board.model?.id == "cudy,tr3600-v1";
 
 let idx = 0;
 let commit;
@@ -56,6 +59,8 @@
 		let width = band.max_width;
 		if (band_name == "2G")
 			width = 20;
+		else if (tr3600 && band_name == "5G")
+			width = min(width, 160);
 		else if (width > 80)
 			width = 80;
 
@@ -93,6 +98,16 @@
 			num_global_macaddr = board.wlan.defaults.ssids?.[band_name]?.mac_count;
 		}
 
+		// Select by detected band, not radio enumeration. Keep the regulatory
+		// country and DFS enforcement; ACS requests an available permitted channel.
+		let tr3600_band = tr3600 && (band_name == '2g' || band_name == '5g');
+		if (tr3600_band) {
+			defaults = { ssid: 'TR3600', encryption: 'sae-mixed', key: 'password' };
+			if (band_name == '5g')
+				channel = 'auto';
+		}
+		let disabled = tr3600_band ? (band_name == '2g' ? 1 : 0) : (defaults ? 0 : 1);
+
 		if (length(info.radios) > 0)
 			id += `\nset ${s}.radio='${radio.index}'`;
 
@@ -104,6 +119,7 @@
 set ${s}.htmode='${htmode}'
 set ${s}.country='${country || ''}'
 set ${s}.num_global_macaddr='${num_global_macaddr || ''}'
+${tr3600_band ? `set ${s}.disabled='${disabled}'` : ''}
 
 set ${si}=wifi-iface
 set ${si}.device='${name}'
@@ -112,7 +128,7 @@
 set ${si}.ssid='${defaults?.ssid || "OpenWrt"}'
 set ${si}.encryption='${defaults?.encryption || encryption}'
 set ${si}.key='${defaults?.key || ""}'
-set ${si}.disabled='${defaults ? 0 : 1}'
+set ${si}.disabled='${disabled}'
 
 `);
 		config[name] = {};
